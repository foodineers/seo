{
    "name": "foodineers/seo",
    "description": "A package to handle the SEO in any Laravel application, big or small.",
    "keywords": [
        "Foodineers",
        "laravel",
        "seo"
    ],
    "homepage": "https://github.com/foodineers/laravel-seo",
    "license": "MIT",
    "authors": [
        {
            "name": "Paride Azzari",
            "email": "paride21azzari@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "spatie/schema-org": "^4.0"
    },
    "require-dev": {
        "foodineers/laravel-devtools": "^1.6",
        "nesbot/carbon": "^3.0",
        "orchestra/testbench": "*"
    },
    "autoload": {
        "psr-4": {
            "Foodineers\\SEO\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foodineers\\SEO\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "rector --ansi",
            "pint --parallel --ansi"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test --ansi",
            "rector --dry-run --ansi"
        ],
        "test:unit": [
            "pest --coverage --exactly=100.0"
        ],
        "pest": "pest --profile",
        "test:types": "phpstan --ansi",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "llm/skills": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foodineers\\SEO\\SEOServiceProvider"
            ],
            "aliases": {
                "SEOService": "Foodineers\\SEO\\Facades\\SEOService"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
