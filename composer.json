{
    "name": "foodieneers/laravel-seo",
    "description": "A package to handle the SEO in any Laravel application, big or small.",
    "keywords": [
        "Foodieneers",
        "laravel",
        "laravel-seo"
    ],
    "homepage": "https://github.com/foodieneers/laravel-seo",
    "license": "MIT",
    "authors": [
        {
            "name": "Paride Azzari",
            "email": "paride21azzari@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.11|^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.9.2",
        "spatie/schema-org": "^4.0"
    },
    "require-dev": {
        "foodieneers/laravel-devtools": "^1.0",
        "nesbot/carbon": "^3.0",
        "orchestra/testbench": "^9.16|^10.0",
        "orchestra/testbench-core": "^9.1.4|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Foodieneers\\Laravel\\SEO\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foodieneers\\Laravel\\SEO\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": [
            "pest --coverage --exactly=100.0"
        ],
        "pest": "pest --profile",
        "test:types": "phpstan --memory-limit=16G",
        "test": [
            "@test:unit",
            "@test:arch",
            "@test:lint",
            "@test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "llm/skills": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foodieneers\\Laravel\\SEO\\LaravelSEOServiceProvider"
            ],
            "aliases": {
                "SEOService": "Foodieneers\\Laravel\\SEO\\Facades\\SEOService"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
